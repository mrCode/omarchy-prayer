#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'date'
require 'json'
require 'omarchy_prayer/first_run'
require 'omarchy_prayer/migrations'
require 'omarchy_prayer/config'
require 'omarchy_prayer/today'
require 'omarchy_prayer/paths'
require 'omarchy_prayer/setup'
require 'fileutils'

def today_cache_fresh?
  data = JSON.parse(File.read(OmarchyPrayer::Paths.today_json))
  data['date'] == Date.today.strftime('%Y-%m-%d')
rescue Errno::ENOENT, JSON::ParserError
  false
end

def ensure_today!
  return if today_cache_fresh?
  schedule = File.expand_path('omarchy-prayer-schedule', __dir__)
  # Send schedule's stdout to stderr so `today` / `next` stdout stays a
  # clean, parseable list — first-run progress still reaches the user.
  ok = system(schedule, out: $stderr)
  return if ok && today_cache_fresh?
  abort <<~MSG.chomp
    omarchy-prayer: could not compute today's times.
      enable the timer:  systemctl --user enable --now omarchy-prayer-schedule.timer
      or refresh now:    omarchy-prayer refresh
  MSG
end

def cmd_today
  ensure_today!
  t = OmarchyPrayer::Today.read
  OmarchyPrayer::Today::ORDER.each { |p| puts format('%-8s %s', p, t.times[p]) }
end

def cmd_next
  ensure_today!
  t = OmarchyPrayer::Today.read
  name, at = t.next_prayer
  puts "#{name} #{at.strftime('%H:%M')}"
end

def cmd_status(argv = [])
  ensure_today!
  t = OmarchyPrayer::Today.read

  # Structured form consumed by the Omarchy 4 shell widget.
  if argv.include?('--json')
    require 'omarchy_prayer/config'
    require 'omarchy_prayer/status'
    puts OmarchyPrayer::Status.to_json(today: t, config: OmarchyPrayer::Config.load)
    return
  end

  # Sanitised at the sink: city is geolocation-derived and this prints
  # straight to the terminal. See OmarchyPrayer::Sanitize.
  require 'omarchy_prayer/sanitize'
  safe = ->(v) { OmarchyPrayer::Sanitize.display(v.to_s) }
  line = "date #{t.date}  source #{t.source}  method #{t.method}  city #{safe.call(t.city)}"
  line += "  hijri #{safe.call(t.hijri)}" if t.hijri
  puts line
end

def cmd_audio(argv)
  require 'omarchy_prayer/audio_setting'
  arg = (argv[0] || 'status').downcase

  state = case arg
          when 'on', 'enable', 'true'   then OmarchyPrayer::AudioSetting.set(true)
          when 'off', 'disable', 'false' then OmarchyPrayer::AudioSetting.set(false)
          when 'toggle'                  then OmarchyPrayer::AudioSetting.toggle
          when 'status'                  then OmarchyPrayer::AudioSetting.enabled?
          else
            warn "usage: omarchy-prayer audio [on|off|toggle|status]"
            exit 1
          end

  if state.nil?
    warn 'config.toml missing — run `omarchy-prayer` first to bootstrap'
    exit 1
  end

  puts state ? 'adhan audio: on' : 'adhan audio: off'
end

def cmd_bar(argv)
  require 'omarchy_prayer/bar_preset'
  require 'omarchy_prayer/bar_setting'
  require 'omarchy_prayer/bar_detect'
  require 'omarchy_prayer/prayer_names'
  require 'omarchy_prayer/config'

  # Without this, a pre-0.2.0 config (still [waybar]) gets a NEW [bar]
  # section appended alongside it; the later [waybar]->[bar] rename then
  # collides with it, producing two [bar] tables that Tomlrb refuses to
  # parse. cmd_tui and cmd_setup already migrate before touching config —
  # bar needs the same guarantee since it can be the very first command run.
  OmarchyPrayer::Migrations.run

  sub = (argv[0] || 'status').downcase
  arg = argv[1]

  case sub
  when 'preset'      then bar_preset(arg)
  when 'names'       then bar_names(arg)
  when 'compact'     then bar_compact(arg)
  when 'quiet'       then bar_quiet(arg)
  when 'status'      then bar_status
  else
    warn 'usage: omarchy-prayer bar [preset|names|compact|quiet|status]'
    exit 1
  end
end

def bar_config_or_abort
  OmarchyPrayer::Config.load
rescue OmarchyPrayer::Config::MissingError => e
  abort "omarchy-prayer: #{e.message}"
end

def bar_preset(name)
  presets = OmarchyPrayer::BarPreset.names
  if name.nil? || name == 'list'
    active = bar_config_or_abort.bar_preset
    presets.each { |p| puts "#{p == active ? '*' : ' '} #{p}" }
    puts '* custom' if active == 'custom'
    return
  end
  unless presets.include?(name)
    warn "unknown preset #{name.inspect} (valid: #{presets.join(', ')})"
    exit 1
  end
  # The `icon` preset is an empty format — the Quickshell widget collapses to
  # its own mosque glyph, but the waybar module has no glyph of its own, so
  # waybar's default `{text}` renders nothing at all: no icon, no tooltip,
  # module effectively gone. Still apply it (the user asked), just warn.
  if name == 'icon' && OmarchyPrayer::BarDetect.detect == :waybar
    warn 'omarchy-prayer: warning — the waybar module has no glyph, so the ' \
         '`icon` preset will make it render empty (no icon, no tooltip). ' \
         'Undo with `omarchy-prayer bar preset full`.'
  end
  OmarchyPrayer::BarSetting.set('format', OmarchyPrayer::BarPreset.format_for(name))
  puts "bar preset: #{name}"
end

def bar_names(script)
  scripts = OmarchyPrayer::PrayerNames::SCRIPTS
  unless scripts.include?(script)
    warn "usage: omarchy-prayer bar names <#{scripts.join('|')}>"
    exit 1
  end
  OmarchyPrayer::BarSetting.set('names', script)
  puts "bar names: #{script}"
end

def bar_compact(value)
  case value
  when 'on', 'true'   then state = true
  when 'off', 'false' then state = false
  else
    warn 'usage: omarchy-prayer bar compact <on|off>'
    exit 1
  end
  OmarchyPrayer::BarSetting.set('compact_countdown', state)
  puts "bar compact countdown: #{state ? 'on' : 'off'}"
end

def bar_quiet(value)
  unless value.to_s.match?(/\A\d+\z/)
    warn 'usage: omarchy-prayer bar quiet <minutes>   (0 disables)'
    exit 1
  end
  minutes = value.to_i
  OmarchyPrayer::BarSetting.set('quiet_until_minutes', minutes)
  puts minutes.zero? ? 'bar quiet: off' : "bar quiet: collapses beyond #{minutes}m"
end

def bar_status
  cfg = bar_config_or_abort
  puts "preset            #{cfg.bar_preset}"
  puts "format            #{cfg.bar_format.inspect}"
  puts "names             #{cfg.names_script}"
  puts "compact countdown #{cfg.compact_countdown? ? 'on' : 'off'}"
  puts "quiet until       #{cfg.quiet_until_minutes.zero? ? 'off' : "#{cfg.quiet_until_minutes}m"}"
end

def cmd_refresh
  schedule = File.expand_path('omarchy-prayer-schedule', __dir__)
  exec(schedule)
end

def cmd_relocate(argv)
  require 'omarchy_prayer/relocate'
  OmarchyPrayer::Relocate.run(argv)
  schedule = File.expand_path('omarchy-prayer-schedule', __dir__)
  exec(schedule)
end

def cmd_mute_today
  if File.exist?(OmarchyPrayer::Paths.mute_today)
    File.delete(OmarchyPrayer::Paths.mute_today)
    puts 'mute-today: cleared'
  else
    OmarchyPrayer::Paths.ensure_state_dir
    FileUtils.touch(OmarchyPrayer::Paths.mute_today)
    puts 'mute-today: set (auto-clears at midnight)'
  end
end

def cmd_tui
  require 'omarchy_prayer/tui'
  OmarchyPrayer::FirstRun.ensure_config!
  OmarchyPrayer::Migrations.run
  # Idempotent — no-op fast path when everything is already in place.
  OmarchyPrayer::Setup.run(io: $stderr)
  OmarchyPrayer::TUI.new.run
end

def cmd_setup
  OmarchyPrayer::FirstRun.ensure_config!
  OmarchyPrayer::Migrations.run
  changes = OmarchyPrayer::Setup.run
  if changes.empty?
    puts 'omarchy-prayer: already set up — nothing to do.'
  else
    changes.each { |line| puts "  - #{line}" }
  end
end

def cmd_adhans(argv)
  require 'omarchy_prayer/adhan_manager'
  require 'omarchy_prayer/adhan_catalog'
  sub = argv.shift
  case sub
  when nil, 'list'
    entries = OmarchyPrayer::AdhanManager.list
    col_key = entries.map { |e| e[:key].length }.max
    col_lbl = entries.map { |e| e[:label].length }.max
    entries.each do |e|
      flag = e[:downloaded] ? '●' : '○'
      puts format("  %s  %-#{col_key}s  %-#{col_lbl}s", flag, e[:key], e[:label])
    end
    puts
    puts '  ● = downloaded    ○ = not downloaded'
    puts '  download:  omarchy-prayer adhans download <key>'
    puts '  set:       omarchy-prayer adhans set <key> [--fajr]'
  when 'download'
    key = argv.shift or abort 'usage: omarchy-prayer adhans download <key>'
    OmarchyPrayer::AdhanManager.download(key)
  when 'set'
    key = argv.shift or abort 'usage: omarchy-prayer adhans set <key> [--fajr]'
    fajr = argv.include?('--fajr')
    OmarchyPrayer::AdhanManager.set(key, fajr: fajr)
  when 'current'
    cur = OmarchyPrayer::AdhanManager.current
    puts "adhan       #{cur[:adhan] || '(unset)'}"
    puts "adhan_fajr  #{cur[:adhan_fajr] || '(unset)'}"
  else
    abort "unknown adhans subcommand: #{sub.inspect}"
  end
end

case ARGV[0]
when nil, 'tui'   then cmd_tui
when 'today'      then cmd_today
when 'next'       then cmd_next
when 'status'     then cmd_status(ARGV[1..] || [])
when 'refresh'    then cmd_refresh
when 'relocate'   then cmd_relocate(ARGV[1..] || [])
when 'mute-today' then cmd_mute_today
when 'audio'      then cmd_audio(ARGV[1..] || [])
when 'bar'        then cmd_bar(ARGV[1..] || [])
when 'adhans'     then cmd_adhans(ARGV[1..] || [])
when 'setup'      then cmd_setup
when '-h', '--help', 'help'
  puts <<~USAGE
    usage: omarchy-prayer [command]

    commands:
      tui           open the TUI (default)
      today         print today's prayer times
      next          print next prayer name + time
      status        print source/method/city/hijri line (--json for structured output)
      refresh       re-run the scheduler
      relocate      update [location] (re-detect via IP, or pass --lat/--lon/--city/--country)
      mute-today    toggle today-only mute flag
      audio         adhan audio on|off|toggle|status
      bar           pill design: preset|names|compact|quiet|status
      adhans        manage adhan audio library (list|download|set|current)
      setup         download default adhans, patch waybar config, enable timers
  USAGE
else
  warn "unknown subcommand: #{ARGV[0].inspect}"
  exit 1
end
